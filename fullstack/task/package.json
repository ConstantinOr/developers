{
    "name": "dishboard",
    "packageManager": "yarn@4.9.2",
    "workspaces": [
        "packages/**"
    ],
    "scripts": {
        "server": "npx nx run server:serve",
        "client": "npx nx run client:start",
        "codecheck": "npx nx run-many --target codecheck --all",
        "codecheck:fix": "npx nx run-many --target codecheck --configuration fix --all"
    },
    "dependencies": {
        "@nx/js": "21.1.3",
        "@nx/react": "21.1.3",
        "@nx/workspace": "21.1.3",
        "@types/jest": "28.1.8",
        "date-fns": "^4.1.0",
        "eslint": "8.24.0",
        "jest": "28.1.3",
        "nx": "21.1.3",
        "prettier": "2.7.1",
        "ts-jest": "28.0.8",
        "ts-node": "^10.9.1",
        "typescript": "4.7.4"
    },
    "devDependencies": {
        "@types/node": "18.8.0",
        "tsconfig-paths": "4.1.0"
    }
}
