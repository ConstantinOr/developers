{
    "name": "server",
    "root": "packages/server",
    "sourceRoot": "packages/server/src",
    "projectType": "application",
    "generators": {},
    "targets": {
        "codecheck": {},
        "build": {
            "executor": "nx:run-script",
            "options": {
                "cwd": "packages/server",
                "script": "build"
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/server",
                "command": "npx nest start --debug 0.0.0.0 --watch"
            }
        },
        "start": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/server",
                "command": "npx nest start --debug 0.0.0.0 --watch"
            }
        },
        "db-create": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/server",
                "command": "sh ./scripts/db-create.sh"
            }
        },
        "migration": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/server",
                "command": "nx run server:migration:generate --name {args.name} && nx run server:migration:run"
            },
            "configurations": {
                "run": {
                    "command": "npx typeorm-ts-node-commonjs migration:run -d ./src/config/typeorm/data-source.ts"
                },
                "revert": {
                    "command": "npx typeorm-ts-node-commonjs migration:revert -d ./src/config/typeorm/data-source.ts"
                },
                "generate": {
                    "command": "npx typeorm-ts-node-commonjs migration:generate -d ./src/config/typeorm/data-source.ts ./src/migrations/{args.name}"
                },
                "create": {
                    "command": "npx typeorm-ts-node-commonjs migration:create -d ./src/config/typeorm/data-source.ts ./src/migrations/{args.name}"
                }
            }
        }
    }
}
